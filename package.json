{
  "name": "open-water",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2020 --outfile=open-water.js",
    "check": "tsc",
    "test": "node --test",
    "theme": "esbuild src/backdrop.ts --bundle --format=esm --target=es2020 --outfile=theme/hooks/backdrop.js",
    "build:gpu": "node scripts/build-gpu.mjs",
    "bench:gpu": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
